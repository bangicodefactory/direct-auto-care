APP_NAME="Direct Auto Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_MA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

ADMIN_NAME="Administrateur"
ADMIN_EMAIL=admin@directautocare.ma
ADMIN_PASSWORD=changeme

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=direct_auto_care
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dev email: set MAIL_MAILER=smtp and fill Mailtrap credentials below. Prod: use a real SMTP provider.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@directautocare.ma"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Per-client white-label (set at provisioning) ───────────────────────────
# Company identity — shown in the app header and on PDF invoices (fiscal IDs).
COMPANY_NAME="Direct Auto Care"
COMPANY_ADDRESS="Casablanca, Maroc"
COMPANY_PHONE="+212 5XX-XXXXXX"
COMPANY_EMAIL="contact@directautocare.ma"
COMPANY_ICE="000000000000000"
COMPANY_IF="00000000"
COMPANY_RC="000000"
# Logo: absolute URL, or a public-relative path (e.g. branding/acme-logo.svg)
# shipped with the deploy. Empty falls back to the themed default logo mark.
COMPANY_LOGO=""

# Theme colours (hex) — injected at runtime via /branding.css, no rebuild needed.
# Leave unset to use the Direct Auto Care palette (amber / green).
THEME_PRIMARY="#F4A81C"
THEME_ACCENT="#2FA84F"
THEME_BG="#F6F2EA"
THEME_TEXT="#211E1A"
THEME_TEXT_MUTED="#6B655E"
THEME_SUCCESS="#2FA84F"
THEME_WARNING="#F4A81C"
THEME_ERROR="#E5484D"

# Meta WhatsApp Cloud API (ADR-001) — obtain from Meta Business Suite
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=

# Sentry — error tracking + light performance tracing.
# Backend (server-side): leave empty to disable. DSN comes from the Laravel project in Sentry.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Environment label in Sentry (falls back to APP_ENV when empty).
SENTRY_ENVIRONMENT=

# Frontend (browser): baked into the JS bundle at build time — public by design.
# VITE_SENTRY_RELEASE / VITE_SENTRY_ENVIRONMENT are injected by CI on deploy builds.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

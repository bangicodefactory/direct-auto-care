# =============================================================================
# STAGING / DEMO environment — Direct Auto Care
# Target: cPanel shared hosting, subdomain of directonderweg.com
#
# Copy to `.env` on the server, fill the DB block + APP_URL, then run:
#   php artisan key:generate
# (see deploy/staging/README.md for the full runbook)
#
# SAFETY: this file is tuned so a public demo with FAKE data cannot send
# real messages or leak errors. Do not "promote" these values to production.
# =============================================================================

APP_NAME="Direct Auto Care — DÉMO"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Casablanca
APP_URL=https://CHANGE-ME.directonderweg.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_MA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Demo admin — shown on the login screen of the staging site.
# Use throwaway credentials; this site is reachable on a client domain.
ADMIN_NAME="Administrateur (démo)"
ADMIN_EMAIL=demo@directonderweg.com
ADMIN_PASSWORD=CHANGE-ME-strong-demo-password

# --- Logging: keep quiet, never debug-level on a client domain ----------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database: a DEDICATED cPanel MySQL DB, separate from the client's site ---
# cPanel prefixes names with your account, e.g. cpuser_garagestg / cpuser_garage
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE-ME_garagestg
DB_USERNAME=CHANGE-ME_garage
DB_PASSWORD=CHANGE-ME

# --- Sessions / cache: DB-backed (tables ship with the default migrations) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Pin cookies to the staging subdomain so they don't collide with the client site
SESSION_DOMAIN=CHANGE-ME.directonderweg.com

# --- Queue: SYNC. Shared hosting can't run a persistent worker; sync runs jobs
#     inline. Combined with the disabled scheduler (see README) nothing fans out
#     to external services in the background.
QUEUE_CONNECTION=sync
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail: LOG only. No SMTP credentials => password-reset / notification mail
#     is written to the log, never delivered. ------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@directonderweg.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- WhatsApp (Meta) — TESTABLE on staging via recipient redirect -----------
# The faker seeder generates realistic +212 Moroccan numbers, so we must never
# send to them. META_WA_REDIRECT_TO routes EVERY message (for every seeded
# client) to one number you control, letting you test the reminder flow safely.
#
#   * Fill the three creds below with your Meta WhatsApp API credentials, AND
#     keep META_WA_REDIRECT_TO set  -> reminders are delivered to your phone.
#   * Leave the three creds blank                                -> WhatsApp is
#     fully disabled (channel fails closed, nothing is sent) even if redirect set.
#
# Your test number must be added as an allowed recipient in your Meta app
# (API Setup -> "To" list) until the WhatsApp Business number is fully approved.
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_REDIRECT_TO=+212626410690

# --- Company / fiscal placeholders (shown on invoices) ----------------------
COMPANY_NAME="Direct Auto Care (démo)"
COMPANY_ADDRESS="Casablanca, Maroc"
COMPANY_PHONE="+212 5XX-XXXXXX"
COMPANY_EMAIL="demo@directonderweg.com"
COMPANY_ICE="000000000000000"
COMPANY_IF="00000000"
COMPANY_RC="000000"
COMPANY_LOGO=""

VITE_APP_NAME="${APP_NAME}"

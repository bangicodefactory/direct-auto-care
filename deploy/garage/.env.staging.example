# =============================================================================
# DEMO / STAGING env — Direct Auto Care @ garage.bangicode.ma
# Target: Namecheap cPanel shared hosting (premium173.web-hosting.com)
#
# One-time on the server: copy to `.env`, fill the DB block + CHANGE-ME values,
# then run the first-time setup in deploy/garage/README.md. CI never touches
# this file (it is rsync-excluded), so your secrets stay on the server only.
#
# SAFETY: tuned so a public demo with FAKE data cannot send real messages or
# leak stack traces. Do NOT promote these values to a real production env.
# =============================================================================

APP_NAME="Direct Auto Care — DÉMO"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Casablanca
APP_URL=https://garage.bangicode.ma

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_MA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Demo admin shown on the login screen — use throwaway credentials.
ADMIN_NAME="Administrateur (démo)"
ADMIN_EMAIL=demo@bangicode.ma
ADMIN_PASSWORD=CHANGE-ME-strong-demo-password

# Logging: quiet, never debug-level on a public demo.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database: a DEDICATED cPanel MySQL DB (cPanel prefixes with your account,
# e.g. cpuser_garage / cpuser_garageusr). Never reuse another site's DB.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE-ME_garage
DB_USERNAME=CHANGE-ME_garageusr
DB_PASSWORD=CHANGE-ME

# Sessions / cache: DB-backed (tables ship with the default migrations).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=garage.bangicode.ma

# Queue: SYNC — shared hosting can't run a persistent worker; jobs run inline.
QUEUE_CONNECTION=sync
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail: LOG only — no SMTP creds, so nothing is actually delivered.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@bangicode.ma"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp (Meta): leave the creds BLANK to keep the channel fully disabled
# (fails closed — nothing is sent). The seeder generates realistic +212 numbers,
# so if you ever test sending, also set META_WA_REDIRECT_TO to a number you own
# (it routes EVERY message to that one number). Keep REDIRECT blank in real prod.
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_REDIRECT_TO=

# Company / fiscal placeholders (shown on invoices).
COMPANY_NAME="Direct Auto Care (démo)"
COMPANY_ADDRESS="Casablanca, Maroc"
COMPANY_PHONE="+212 5XX-XXXXXX"
COMPANY_EMAIL="demo@bangicode.ma"
COMPANY_ICE="000000000000000"
COMPANY_IF="00000000"
COMPANY_RC="000000"
COMPANY_LOGO=""
COMPANY_SHOW_PRODUCT_UNITS=true

VITE_APP_NAME="${APP_NAME}"

# Sentry (server-side). DSN from the Laravel project in Sentry; leave blank to disable.
# SENTRY_ENVIRONMENT inherits APP_ENV (=staging) when blank. The frontend DSN/release
# are injected by CI at build time (deploy.yml), not from this file.
SENTRY_LARAVEL_DSN=CHANGE-ME-or-blank
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=

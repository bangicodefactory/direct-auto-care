# Disable postinstall scripts by default to block supply-chain attack payloads.
# Mini Shai-Hulud and similar worms execute via postinstall.
# If a package genuinely requires scripts (e.g. native bindings), install it
# explicitly with: npm install <pkg> --ignore-scripts=false
ignore-scripts=true

# KNOWN EXCEPTION: lefthook git hooks are not auto-installed by postinstall.
# After every `npm ci`, run: npx lefthook install
# (lefthook's own binary still works — only its postinstall hook-wiring is skipped)
